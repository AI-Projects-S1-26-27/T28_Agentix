{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://healthsensing-backend.onrender.com/api/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "https://healthsensing-backend.onrender.com/ws/:path*"
    },
    {
      "source": "/health",
      "destination": "https://healthsensing-backend.onrender.com/health"
    }
  ]
}
